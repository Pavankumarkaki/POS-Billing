# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# Android
android/.gradle/
android/local.properties
android/key.properties
*.jks
*.keystore

# Never commit secrets or signing material
*.p12
*.pem
secrets/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store

# Test output
coverage/
test/**/failures/

# Generated Dart, none of it committed. db.g.dart alone is ~11k lines and
# would dominate every diff and every merge. Regenerate with:
#   dart run build_runner build --delete-conflicting-outputs
# The l10n files regenerate on their own during pub get and build, because
# pubspec.yaml sets `generate: true`.
*.g.dart
lib/l10n/app_localizations*.dart
